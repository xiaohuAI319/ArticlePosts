{
  "environment": { "envId": "REPLACE_WITH_YOUR_ENV_ID" },
  "framework": {
    "name": "aixiaohu-next",
    "plugins": {
      "next": {
        "use": "@cloudbase/framework-plugin-next",
        "inputs": {
          "buildCommand": "npm run build",
          "outputPath": ".next",
          "cloudPath": "/",
          "functionName": "aixiaohu-next-fn",
