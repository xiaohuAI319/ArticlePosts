{
  "name": "article-multi-publisher",
  "version": "1.0.0",
  "description": "文章一键多发平台 - 支持多平台发布的桌面应用",
  "main": "src/main/index.js",
  "homepage": "./",
  "author": "Article Publisher Team",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "webpack serve --mode development",
    "dev:main": "electron . --dev",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "webpack --mode production",
    "build:main": "electron-builder",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:tdd": "node scripts/test.js",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/main",
    "test:integration": "jest tests/renderer",
    "lint": "eslint src --ext .js,.jsx",
    "lint:fix": "eslint src --ext .js,.jsx --fix",
    "package": "electron-builder --publish=never",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.0.0",
    "@tinymce/tinymce-react": "^5.0.0",
    "antd": "^5.12.0",
    "axios": "^1.6.0",
    "better-sqlite3": "^9.2.0",
    "crypto-js": "^4.2.0",
    "electron": "^28.0.0",
    "puppeteer-core": "^21.6.0",
    "qrcode": "^1.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^9.0.0",
    "redux-persist": "^6.0.0",
    "styled-components": "^6.1.0",
    "tinymce": "^6.8.0",
    "uuid": "^9.0.0",
    "wrap-ansi": "^9.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.22.0",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^14.1.0",
    "babel-loader": "^9.1.0",
    "concurrently": "^8.2.0",
    "css-loader": "^6.8.0",
    "debug": "^4.4.3",
    "electron-builder": "^24.8.0",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "file-loader": "^6.2.0",
    "global": "^4.4.0",
    "html-webpack-plugin": "^5.6.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "style-loader": "^3.3.0",
    "url-loader": "^4.1.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^4.15.0"
  },
  "build": {
    "appId": "com.articlepublisher.app",
    "productName": "文章多发助手",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/main/**/*",
      "build/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "keywords": [
    "electron",
    "react",
    "文章发布",
    "内容管理",
    "多平台发布"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
